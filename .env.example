# Копирай този файл като .env.local и попълни стойностите от
# Supabase -> Project Settings -> API Keys (или бутона Connect).

# Адрес на проекта (публичен)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Публичен ключ ("publishable" или "anon"). Безопасен е за браузъра.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Таен ключ ("secret" или "service_role").
# САМО за сървъра. Никога не го слагай в код, чат или публично хранилище.
SUPABASE_SECRET_KEY=

# ---------- Имейли (Resend) ----------
# Ключ от resend.com -> API Keys. САМО за сървъра, без префикс NEXT_PUBLIC_.
# Ако липсва, запитванията пак се записват, просто без имейли.
RESEND_API_KEY=

# Къде да идват известията за нови запитвания (имейлът на собственика).
# Без собствен домейн Resend праща само до имейла, с който е регистриран акаунтът.
OWNER_EMAIL=

# Подател. Ако е празно: ЗеленоВкъщи <onboarding@resend.dev>
# След като добавиш свой домейн в Resend, напр.: ЗеленоВкъщи <oferti@твоя-домейн.bg>
EMAIL_FROM=
